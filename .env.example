# AI Provider Configuration
# Choose one: ollama, openai, claude
LLM_PROVIDER=ollama

# API Keys (only required for their respective providers)
# For Claude/Anthropic:
ANTHROPIC_API_KEY=your-anthropic-api-key
# For OpenAI:
OPENAI_API_KEY=your-openai-api-key
# For Ollama: No API key needed (local installation)

# Storage Configuration
# Choose one: libsql, mysql
STORAGE_TYPE=libsql

# LibSQL Configuration
LIBSQL_URL=file:../mastra.db

# MySQL Configuration (if using MySQL storage)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=mastra_db
# MYSQL_USERNAME=your-username
# MYSQL_PASSWORD=your-password

# Database Connection (for diagnostic tools)
# These settings are used by the database diagnostic tool
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your-database-name
DB_USERNAME=your-username
DB_PASSWORD=your-password

# External System Configuration
# GitHub repository for source code search
GITHUB_REPOSITORY=https://github.com/logiless/logiless
# Help documentation URL for RAG search
HELP_DOCS_URL=https://docs.logiless.com/

# Optional: Additional configuration
# LOG_LEVEL=info
# NODE_ENV=development